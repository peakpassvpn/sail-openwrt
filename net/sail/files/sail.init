#!/bin/sh /etc/rc.common
# sail under procd: the configuration is checked before each start and
# reload. A reload restarts sail when its configuration file or its UCI
# settings changed: sail's own in-place reload (SIGHUP) takes new users
# and certificates only, and keeps the rest as it was.

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/sail

start_service() {
	config_load sail
	local enabled config profile cache_dir
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get config main config /etc/sail/config.json
	config_get profile main profile router
	config_get cache_dir main cache_dir /var/lib/sail
	mkdir -p "$cache_dir"

	if ! "$PROG" --config "$config" --data-dir /etc/sail --cache-dir "$cache_dir" \
		--profile "$profile" --test >/dev/null 2>/tmp/sail.check; then
		logger -t sail -p daemon.err "$config: $(cat /tmp/sail.check)"
		rm -f /tmp/sail.check
		return 1
	fi
	rm -f /tmp/sail.check

	procd_open_instance
	procd_set_param command "$PROG" --config "$config" --data-dir /etc/sail \
		--cache-dir "$cache_dir" --profile "$profile"
	procd_set_param file "$config"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 45
	procd_close_instance
}

reload_service() {
	config_load sail
	local config profile cache_dir
	config_get config main config /etc/sail/config.json
	config_get profile main profile router
	config_get cache_dir main cache_dir /var/lib/sail
	# A configuration that does not check keeps the running one; one that
	# does is started again by procd if it, or the command line, changed.
	"$PROG" --config "$config" --data-dir /etc/sail --cache-dir "$cache_dir" \
		--profile "$profile" --test >/dev/null || return 1
	start
}

service_triggers() {
	procd_add_reload_trigger sail
}
